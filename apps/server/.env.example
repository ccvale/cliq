# Port the API listens on
PORT=4000
# Postgres connection string. Leave empty to use an embedded PGlite database in ./data
# Supabase: Project Settings → Database → Connection string → "Session pooler" (port 5432)
DATABASE_URL=
# Optional: the database's CA certificate (PEM, \n for newlines) to verify TLS, e.g. Supabase's from the same page
DATABASE_CA=
# Set to 1 only behind one reverse proxy (Render, Fly, Railway) so rate limits use the real client IP
TRUST_PROXY=
# Long random string used to sign access tokens (openssl rand -base64 48)
JWT_SECRET=change-me
# Comma separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:8081
# Sign in with Apple: your app's bundle identifier (and Services ID for web), comma separated
APPLE_AUDIENCES=
# Sign in with Google: OAuth client IDs (iOS, Android, web), comma separated
GOOGLE_AUDIENCES=
# Outgoing email for verification and password reset codes, e.g. smtps://user:pass@smtp.example.com:465
# Leave empty in development: codes are printed to the server log instead.
SMTP_URL=
MAIL_FROM="Cliq <hello@cliq.fi>"
# GIF search in chat: a free API key from developers.giphy.com. Leave empty to hide the GIF button.
GIPHY_API_KEY=
