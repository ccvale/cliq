# Where the Cliq API runs. Leave empty in development to use port 4000 on the machine running Metro.
EXPO_PUBLIC_API_URL=
# Google sign in: OAuth client IDs from Google Cloud. The button only appears on platforms with an id.
# Add the same ids to GOOGLE_AUDIENCES on the server.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
